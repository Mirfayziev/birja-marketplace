# Ushbu faylni .env nomi bilan nusxalab, qiymatlarni to'ldiring.
# .env faylni HECH QACHON Git repositoriyaga qo'shmang (.gitignore da bor).

FLASK_ENV=development
SECRET_KEY=almashtiring-tasodifiy-va-uzun-qator
JWT_SECRET_KEY=almashtiring-boshqa-tasodifiy-qator

# Railway/Render PostgreSQL avtomatik beradi, lokalda SQLite ishlatilishi mumkin
DATABASE_URL=sqlite:///local.db

# CORS - frontend manzili(lari), vergul bilan ajratiladi
CORS_ORIGINS=http://localhost:5173

# Birinchi superadmin (flask seed-admin buyrug'i uchun)
ADMIN_PHONE=+998900000000
ADMIN_PASSWORD=ChangeMe123!

# --- Payme ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# --- Click ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
